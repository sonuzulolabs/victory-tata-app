# =============================================================================
# Victory Tata mobile app — public env (baked into EAS builds via eas.json too)
# Copy to .env.local for local Expo; production values also in eas.json build profiles.
# =============================================================================

# CRM origin WITHOUT /api/v1 — e.g. https://victorytata.zulolabs.com
EXPO_PUBLIC_API_URL=https://victorytata.zulolabs.com

# Victory Admin → Settings → API Keys (Bearer token for /api/v1 and /api/testing/v1)
EXPO_PUBLIC_API_KEY=

# Android preview/dev APKs (sideload): force reCAPTCHA for phone OTP when Play Integrity fails.
# Production store builds usually omit this.
# EXPO_PUBLIC_FIREBASE_FORCE_RECAPTCHA=1

# =============================================================================
# PRODUCTION (EAS)
# =============================================================================
# Set EXPO_PUBLIC_* in eas.json → build → env for preview/production profiles.
# Rebuild APK/AAB after changing API URL or key.
# Firebase Android: google-services.json in project root (from Firebase Console).
# FCM: device registers via /api/testing/v1/device-tokens after login.
# =============================================================================
